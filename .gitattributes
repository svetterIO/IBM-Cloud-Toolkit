# Set default behaviour to automatically normalize line endings
* text=auto

# Shell scripts always use LF
*.sh text eol=lf

# Python scripts always use LF
*.py text eol=lf

# PowerShell scripts use CRLF
*.ps1 text eol=crlf

# Text files
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cfg text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
